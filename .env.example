NEXT_PUBLIC_SITE_URL=your_site_url
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=your_gemini_model
GEMINI_EMBEDDING_MODEL=your_gemini_embedding_model
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
GITHUB_TOKEN=your_github_token
# The analytics credentials are optional. Leave them as they are and the
# analytics layer stays in its console only mode, which writes the events to
# the terminal in development and sends nothing anywhere. Fill them in with
# the project key and the host of a PostHog project to switch the sending on.
POSTHOG_KEY=your_posthog_key
POSTHOG_HOST=your_posthog_host
SENTRY_DSN=your_sentry_dsn
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token
# The limits of the chat. They are optional and default to the values PRD §48
# suggests: twenty messages every thirty minutes and a hundred a day.
RATE_LIMIT_WINDOW_SECONDS=1800
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_DAILY_MAX=100
# The limits of the job fit analyzer. They are optional and default to
# stricter values: five analyses every thirty minutes and ten a day.
JOB_FIT_WINDOW_SECONDS=1800
JOB_FIT_MAX_REQUESTS=5
JOB_FIT_DAILY_WINDOW_SECONDS=86400
JOB_FIT_DAILY_MAX_REQUESTS=10
JOB_FIT_MAX_TOKENS=2048
# The limits of the contact form. They are optional and default to
# stricter values: three submissions every thirty minutes and five a day.
CONTACT_FORM_WINDOW_SECONDS=1800
CONTACT_FORM_MAX_REQUESTS=3
CONTACT_FORM_DAILY_WINDOW_SECONDS=86400
CONTACT_FORM_DAILY_MAX_REQUESTS=5
# Email delivery configuration. EMAIL_PROVIDER can be 'resend' or 'console'.
# 'console' logs emails to stdout (for development). 'resend' uses the Resend API.
EMAIL_PROVIDER=console
EMAIL_API_KEY=your_resend_api_key
EMAIL_TO=contact@ankitnandwani.com
EMAIL_FROM=Contact Form <noreply@ankitnandwani.com>
EMAIL_REPLY_TO=
